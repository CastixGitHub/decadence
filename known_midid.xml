<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/">
  <interface name="org.freedesktop.DBus.Introspectable">
      <method name="Introspect">
          <arg name="xml_data" direction="out" type="s" />
        </method>
    </interface>
    <interface name="org.gna.home.a2jmidid.control">
      <method name="exit" />
        <method name="start" />
        <method name="stop" />
        <method name="is_started">
          <arg name="started" direction="out" type="b" />
        </method>
        <method name="get_jack_client_name">
          <arg name="jack_client_name" direction="out" type="s" />
        </method>
        <method name="map_alsa_to_jack_port">
          <arg name="alsa_client_id" direction="in" type="u" />
            <arg name="alsa_port_id" direction="in" type="u" />
            <arg name="map_playback" direction="in" type="b" />
            <arg name="jack_port_name" direction="out" type="s" />
        </method>
        <method name="map_jack_port_to_alsa">
          <arg name="jack_port_name" direction="in" type="s" />
            <arg name="alsa_client_id" direction="out" type="u" />
            <arg name="alsa_port_id" direction="out" type="u" />
            <arg name="alsa_client_name" direction="out" type="s" />
            <arg name="alsa_port_name" direction="out" type="s" />
        </method>
        <method name="set_hw_export">
          <arg name="hw_export" direction="in" type="b" />
        </method>
        <method name="get_hw_export">
          <arg name="hw_export" direction="out" type="b" />
        </method>
        <method name="set_disable_port_uniqueness">
          <arg name="disable_port_uniqueness" direction="in" type="b" />
        </method>
        <method name="get_disable_port_uniqueness">
          <arg name="disable_port_uniqueness" direction="out" type="b" />
        </method>
        <signal name="bridge_started" />
        <signal name="bridge_stopped" />
    </interface>
</node>
